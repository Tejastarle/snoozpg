# ─── Site ────────────────────────────────────────────────
# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.snoozcapsules.com

# ─── Supabase ────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used by /api/leads to store enquiries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Salt used to hash visitor IPs for enquiry rate limiting (any long random string)
LEAD_IP_SALT=change-me-to-a-long-random-string

# Optional: POST every new lead as JSON to this URL (Zapier / Make / n8n / Slack workflow)
LEAD_NOTIFY_WEBHOOK_URL=

# ─── Analytics (all optional) ────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Demo mode ───────────────────────────────────────────
# When Supabase is NOT configured, "true" lets you explore the admin panel with sample
# data and test the enquiry form without saving anything. Keep "false" in production.
NEXT_PUBLIC_DEMO_MODE=false
